<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.example.bookie.FeedFragment"
        android:label="fragment_feed"
        tools:layout="@layout/fragment_feed" />
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.bookie.AccountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.bookie.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
        <action
            android:id="@+id/action_homeFragment_to_accountFragment"
            app:destination="@id/accountFragment" />
        <action
            android:id="@+id/action_homeFragment_to_unreadBookFragment"
            app:destination="@id/unreadBookFragment" />
    </fragment>
    <fragment
        android:id="@+id/unreadBookFragment"
        android:name="com.example.bookie.UnreadBookFragment"
        android:label="fragment_unread_book"
        tools:layout="@layout/fragment_unread_book" >
        <action
            android:id="@+id/action_unreadBookFragment_to_readBookFragment"
            app:destination="@id/readBookFragment" />
        <action
            android:id="@+id/action_unreadBookFragment_to_addUnreadBookFragment"
            app:destination="@id/addUnreadBookFragment" />
    </fragment>
    <fragment
        android:id="@+id/readBookFragment"
        android:name="com.example.bookie.ReadBookFragment"
        android:label="fragment_read_book"
        tools:layout="@layout/fragment_read_book" >
        <action
            android:id="@+id/action_readBookFragment_to_unreadBookFragment"
            app:destination="@id/unreadBookFragment" />
    </fragment>
    <fragment
        android:id="@+id/addUnreadBookFragment"
        android:name="com.example.bookie.AddUnreadBookFragment"
        android:label="fragment_add_unread_book"
        tools:layout="@layout/fragment_add_unread_book" >
        <action
            android:id="@+id/action_addUnreadBookFragment_to_unreadBookFragment"
            app:destination="@id/unreadBookFragment" />
    </fragment>
</navigation>