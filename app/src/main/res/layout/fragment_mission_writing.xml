<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- 상단 타이틀 -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="미션 수행하기"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 발행 버튼 -->
    <Button
        android:id="@+id/publishButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="발행"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/infoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="독서 일기 속 미션타임!"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/publishButton" />

    <!-- 미션1: 질문 텍스트 -->
    <TextView
        android:id="@+id/mission1Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="미션1. 이 책을 읽으며 가장 기억에 남는 구절은 무엇인가요?\n
                        기억에 남는 한 줄 - 책 제목으로 작성해주세요 !"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/infoText" />

    <!-- 미션1: 글 작성 폼 -->
    <EditText
        android:id="@+id/mission1EditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="기록은 기억을 대체한다 – 탈무드"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/mission1Text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- 미션2: 질문 텍스트 -->
    <TextView
        android:id="@+id/mission2Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="미션2. 가장 기억 남는 구절 하나를 뽑아 그 페이지를 사진찍어 공유해주세요!"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mission1EditText" />

    <!-- 미션2: 사진 첨부 기능 -->
    <LinearLayout
        android:id="@+id/photoAttachLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/mission2Text"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 사진 첨부 아이콘 -->
        <ImageView
            android:id="@+id/add_photo_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/gallery"
            android:contentDescription="사진 첨부"
            android:layout_marginEnd="8dp" />

        <!-- 사진 추가 텍스트 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사진 추가"
            android:textSize="16sp"
            android:gravity="center_vertical" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
