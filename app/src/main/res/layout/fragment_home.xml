<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".HomeFragment">

    <!-- 인사말 텍스트 -->
    <TextView
        android:id="@+id/greeting_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center_horizontal" />

    <!-- 목표 링과 텍스트를 포함하는 FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/goal_ring"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:max="100"
            app:indicatorSize="200dp"
            app:trackThickness="20dp" />

        <TextView
            android:id="@+id/goal_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 목표 설명 텍스트 -->
    <TextView
        android:id="@+id/txt_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:text="목표 도서, 작지만 확실한 성취감이 기다리고 있어요."
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 책 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/book_list"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="16dp" />

    <!-- 미션 목록 제목 -->
    <TextView
        android:id="@+id/mission_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:text="당신의 독서가 만든 문장들"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center_horizontal" />

    <!-- 미션 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mission_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/mission_list_background" />

    <!-- 미션 시작 버튼 -->
    <Button
        android:id="@+id/btn_start_mission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="미션 시작하기"
        android:gravity="center"
        android:textStyle="bold" />
</LinearLayout>
